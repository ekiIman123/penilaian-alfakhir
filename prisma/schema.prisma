generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id           String         @id @default(cuid())
  name         String
  role         String         @default("guru")
  lembaga      String         @default("alfakhir")
  divisi       String?
  accessCode   String?        @unique
  phone        String?
  finalCatatan String?
  assignments  Assignment[]
  evaluations  Evaluation[]
  results      PeriodResult[]
  createdAt    DateTime       @default(now())

  @@unique([name, role, lembaga])
}

model Evaluator {
  id          String       @id @default(cuid())
  name        String
  lembaga     String       @default("alfakhir")
  role        String       @default("evaluator")
  divisi      String?
  accessCode  String?      @unique
  phone       String?
  accountId   String?
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  evaluations Evaluation[]
  createdAt   DateTime     @default(now())

  @@unique([name, lembaga])
  @@index([accountId])
}

/// Satu orang bisa memegang beberapa jabatan di lembaga berbeda — Kamal
/// supervisor IYSA sekaligus CEO ICGI, Pak Deni manajemen di ketiganya.
/// Account menyatukannya jadi satu kali masuk, bukan tiga.
model Account {
  id           String      @id @default(cuid())
  name         String
  accessCode   String?     @unique
  isSuperadmin Boolean     @default(false)
  evaluators   Evaluator[]
  createdAt    DateTime    @default(now())
}

/// Siapa menilai siapa, sebagai data — bukan rangkaian if di dalam kode.
/// Bobot mencerminkan kedekatan dengan pekerjaan harian orang yang dinilai.
model Assignment {
  id          String    @id @default(cuid())
  evaluatorId String
  employeeId  String
  lembaga     String
  weight      Float     @default(1)
  activeFrom  DateTime  @default(now())
  activeTo    DateTime?
  evaluator   Evaluator @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([evaluatorId, employeeId])
  @@index([lembaga])
}

/// Jejak tindakan yang tidak boleh hilang: membuka kunci periode, menerbitkan
/// dan menarik rapor, mengubah nilai setelah periode ditutup.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String
  target    String
  lembaga   String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([lembaga, createdAt])
  @@index([target])
}

model Evaluation {
  id          String    @id @default(cuid())
  evaluatorId String
  employeeId  String
  periodId    String
  lembaga     String    @default("alfakhir")
  rubricType  String    @default("standard")
  status      String    @default("draf")
  submittedAt DateTime?
  evaluator   Evaluator @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period      Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  scores      String
  catatan     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([periodId, evaluatorId, employeeId])
  @@index([periodId, employeeId])
  @@index([periodId, evaluatorId, status])
}

model OrgSettings {
  id                     String   @id
  lembaga                String   @default("alfakhir")
  yayasanName            String   @default("YAYASAN AL FAKHIR")
  schoolName             String   @default("SMP AL FAKHIR JAKARTA SELATAN")
  address                String   @default("Jl. Ciledug Raya, Jakarta Selatan")
  phone                  String   @default("")
  city                   String   @default("Jakarta")
  periodLabel            String   @default("Semester Ganjil 2025/2026")
  kepalaSekolah          String   @default("")
  kepalaTitle            String   @default("Kepala SMP Islam Modern Al Fakhir")
  kepalaSignatureBase64  String?
  signer2Name            String   @default("")
  signer2Title           String   @default("Deputi Litbang & SDM Al Fakhir")
  signer2SignatureBase64 String?
  ketuaName              String   @default("")
  ketuaTitle             String   @default("Owner & Founder Al Fakhir")
  ketuaSignatureBase64   String?
  logoBase64             String?
  updatedAt              DateTime @updatedAt
}

model Period {
  id          String         @id
  lembaga     String
  year        Int
  month       Int
  label       String
  status      String         @default("draf")
  opensAt     DateTime
  closesAt    DateTime
  publishedAt DateTime?
  evaluations Evaluation[]
  results     PeriodResult[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([lembaga, year, month])
  @@index([lembaga, status])
}

model PeriodResult {
  id             String    @id @default(cuid())
  periodId       String
  employeeId     String
  lembaga        String
  rubricType     String
  totalScore     Float
  maxScore       Int
  gradeLabel     String
  sectionScores  String
  evaluatorCount Int
  finalCatatan   String?
  publishedAt    DateTime  @default(now())
  readAt         DateTime?
  tanggapan      String?
  period         Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

/// Catatan percobaan masuk, untuk membatasi tebakan kode akses secara massal.
/// Kode akses hanya sepanjang beberapa karakter dan tidak punya kata sandi
/// pendamping, sehingga tanpa pembatasan ini seluruh ruang kode bisa dicoba.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  berhasil  Boolean  @default(false)
  jenis     String   @default("penilai")
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}
